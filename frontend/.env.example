# ==============================================================================
# Variables de entorno de NiñasPro Hub (Plantilla)
# Copia este archivo a .env y asigna los valores correspondientes
# NUNCA agregues ni commitees tus claves reales al repositorio
# ==============================================================================

# URL de tu proyecto de Supabase (por ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon pública de Supabase
SUPABASE_ANON_KEY=tu_clave_anon_aqui
